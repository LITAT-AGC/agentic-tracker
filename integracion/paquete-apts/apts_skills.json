    },
    {
      "name": "apts_set_status",
      "description": "Advance a story (backlog item) through the method state machine (ready_for_dev -> in_progress -> review -> done). The server validates the transition and rejects invalid ones with 409. This is the method's state machine, distinct from update_backlog_item (free-form edit). Story-only in this version (epic/initiative phase advance is handled by apts_next).",
      "parameters": {
        "type": "object",
        "properties": {
          "backlog_item_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
