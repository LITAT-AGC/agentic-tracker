{
  "skills": [
    {
      "name": "register_task",
      "description": "Create or resume a task in the project. Minimum payload via the official MCP server: title (the integration layer supplies project_url, agent_name, and agent_email). AI-agent flows should use the official MCP server and never generate fresh direct-client bootstrap code. When backlog_item_id points to an active task in todo, in_progress, or stalled, APTS resumes that task instead of creating a duplicate.",
      "parameters": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "project_url": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "agent_name": {
                "type": "string"
              },
              "agent_email": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "backlog_item_id": {
                "type": "string"
              }
            },
            "required": [
              "title"
            ]
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "project_url": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "agent_name": {
                  "type": "string"
                },
                "agent_email": {
                  "type": "string"
                },
                "context": {
                  "type": "string"
                },
                "backlog_item_id": {
                  "type": "string"
                }
              },
              "required": [
                "title"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "read_project_context",
      "description": "Read current project state with optional section selection. Minimum payload via the official MCP server: none for identity (the integration layer supplies url). Optional: limit (logs only), backlog_status, include, view, and per-section pagination. The tasks and backlog sections are paginated to protect the agent context window: each defaults to 50 items (max 200) and is windowed via tasks_limit/tasks_offset and backlog_limit/backlog_offset. For the execution loop prefer apts_next/apts_workflow_step; use this call for one-off orientation and page through large backlogs instead of fetching everything. Agent flows now default to compact summaries; request view=full only when raw detail is needed.",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "limit": {
            "type": "number",
            "default": 5
          },
          "tasks_limit": {
            "type": "number",
            "default": 50
          },
          "tasks_offset": {
            "type": "number",
            "default": 0
          },
          "backlog_limit": {
            "type": "number",
            "default": 50
          },
          "backlog_offset": {
            "type": "number",
            "default": 0
          },
          "backlog_status": {
            "type": "string",
            "enum": [
              "draft",
              "needs_details",
              "ready",
              "in_progress",
              "review",
              "blocked",
              "done",
              "archived"
            ]
          },
          "include": {
            "oneOf": [
              {
                "type": "string",
                "description": "Comma-separated sections: tasks,backlog,logs"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "tasks",
                    "backlog",
                    "logs"
                  ]
                }
              }
            ]
          },
          "view": {
            "type": "string",
            "enum": [
              "full",
              "compact"
            ],
            "default": "compact"
          }
        },
        "required": []
      }
    },
    {
      "name": "list_backlog_items",
      "description": "List backlog items for a project ordered by priority and sort order. Minimum payload via the official MCP server: none for identity (the integration layer supplies url). Optional filters include id, ids, status, and pagination with limit/offset. To protect the agent context window the result is paginated: limit defaults to 50 items (max 200) and offset defaults to 0, so page through large backlogs instead of fetching everything. Agent flows now default to compact summaries; request view=full only for chosen items.",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "ids": {
            "oneOf": [
              {
                "type": "string",
                "description": "Comma-separated UUID list"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "needs_details",
              "ready",
              "in_progress",
              "review",
              "blocked",
              "done",
              "archived"
            ]
          },
          "include_deleted": {
            "type": "boolean",
            "default": false
          },
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          },
          "view": {
            "type": "string",
            "enum": [
              "full",
              "compact"
            ],
            "default": "compact"
          }
        },
        "required": []
      }
    },
