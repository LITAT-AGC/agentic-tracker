    {
      "name": "apts_next",
      "description": "Resolve the next deterministic method step for an agent in a project (server-authoritative method engine). Minimum payload via the official MCP server: none (the integration layer supplies project_url and agent_name). Returns a single directive { next: run_step|wait|done|blocked, target_id, role, why, args } for the calling agent's required role, advancing the lifecycle phase and claiming iterable work without collision across agents. Use this instead of reading and reasoning over project state in-context.",
      "parameters": {
        "type": "object",
        "properties": {
          "project_url": {
            "type": "string"
          },
          "agent_name": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    {
      "name": "apts_status",
      "description": "Read the method state of a project in data-mode: backlog item counts by status for the active epic, current lifecycle phase, progress, and a single read-only recommendation line (computed via apts_next without mutating state). Minimum payload via the official MCP server: none (the integration layer supplies project_url; pass agent_name for an agent-specific recommendation).",
      "parameters": {
        "type": "object",
        "properties": {
          "project_url": {
            "type": "string"
          },
          "agent_name": {
            "type": "string"
          }
