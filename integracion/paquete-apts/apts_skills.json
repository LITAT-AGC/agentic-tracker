              "in_progress",
              "review",
              "done"
            ]
          }
        },
        "required": [
          "backlog_item_id",
          "status"
        ]
      }
    },
    {
      "name": "apts_workflow_step",
      "description": "Serve the current generative workflow step for an agent by goteo (model B: fresh context per step). The server reconstructs the step payload from server-authoritative state (the agent's cursor in project_state): it re-cables the verbatim instruction_chunk at serve-time and reinjects only what the step needs[] as bounded slices, so per-step context stays ~constant regardless of project size. Returns { mode: run|await_input|wait|done|blocked, workflow_key, step_key, step_order, goal, role, target_id, instruction_chunk, template_slice, needs[], outputs[] }. If the step is an elicitation point, mode='await_input' with questions[]; resume by calling again with `answers`. Minimum payload via the official MCP server: none (the integration layer supplies project_url and agent_name).",
      "parameters": {
        "type": "object",
        "properties": {
          "project_url": {
            "type": "string"
          },
          "agent_name": {
            "type": "string"
          },
          "answers": {
            "type": "object"
          }
        },
        "required": []
      }
    },
    {
      "name": "apts_submit_step",
      "description": "Capture the output of the current workflow step and advance the cursor (goteo, model B). Doc artifacts are persisted as typed semantic_documents (doc_type from the enum: brief/prd/architecture/epics/story_spec/retro), code is recorded as a reference (code_ref), and iterable units update the claimed story's status. What is captured is decided by the step's declared outputs[] (coherent with the workflow-level completion that apts_next checks). Then it advances to the next step, or closes the workflow and releases the pointer. Returns { ok, captured[], advanced_to, workflow_complete }. Pass the produced content/reference in `output`. Minimum payload via the official MCP server: none (the integration layer supplies project_url and agent_name).",
      "parameters": {
        "type": "object",
        "properties": {
          "project_url": {
            "type": "string"
          },
          "agent_name": {
            "type": "string"
          },
          "output": {
            "type": "object"
          }
        },
        "required": []
      }
    },
    {
      "name": "create_initiative",
      "description": "Bootstrap a conducible BMAD method initiative for a project (server-authoritative method engine). Creates - idempotently by (project_url, active status) - an initiative in the 'analysis' phase scoped to the seeded BMAD library (source_ref 'bmad:v6.8.0'), folds in one empty epic (the engine needs an epic in implementation and there is no epic tool), and optionally stores the client's spec as a typed semantic_documents artifact linked to the initiative (the server has no access to the client repo filesystem). Returns { initiative_id, epic_id, phase, created|resumed, roster }, where roster.entity_keys lists the valid entity_key values for set_agent_role in this initiative's library. After bootstrap, apts_next stops returning 'blocked' and delivers the first real step. Minimum payload via the official MCP server: title (the integration layer supplies project_url).",
      "parameters": {
        "type": "object",
        "properties": {
          "project_url": {
            "type": "string"
          },
          "title": {
